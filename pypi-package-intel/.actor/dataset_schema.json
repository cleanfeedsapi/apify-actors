{
  "actorSpecification": 1,
  "fields": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "ecosystem": { "type": "string", "description": "pypi | npm" },
      "name": { "type": "string" },
      "version": { "type": "string" },
      "summary": { "type": ["string", "null"] },
      "license": { "type": ["string", "null"] },
      "homepage": { "type": ["string", "null"] },
      "repository": { "type": ["string", "null"] },
      "author": { "type": ["string", "null"] },
      "requires_python": { "type": ["string", "null"], "description": "PyPI only" },
      "engines": { "type": ["string", "null"], "description": "npm engines JSON string, or null" },
      "keywords": { "type": "array", "items": { "type": "string" } },
      "dependencies_count": { "type": "integer" },
      "release_date": { "type": ["string", "null"], "description": "ISO 8601 latest release" },
      "first_release_date": { "type": ["string", "null"], "description": "ISO 8601 first seen release" },
      "releases_count": { "type": "integer" },
      "downloads_last_week": { "type": ["integer", "null"] },
      "url": { "type": "string", "description": "Public project page" }
    },
    "required": ["ecosystem", "name", "version", "url", "dependencies_count", "releases_count", "keywords"]
  },
  "views": {
    "overview": {
      "title": "Packages",
      "transformation": {
        "fields": [
          "ecosystem",
          "name",
          "version",
          "license",
          "dependencies_count",
          "downloads_last_week",
          "release_date",
          "url"
        ]
      },
      "display": {
        "component": "table",
        "properties": {
          "url": { "label": "Project", "format": "link" },
          "release_date": { "label": "Latest", "format": "date" },
          "ecosystem": { "label": "Eco" }
        }
      }
    }
  }
}
