{
  "title": "Lever Jobs Feed input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "boards": {
      "title": "Boards",
      "type": "array",
      "description": "Lever boards as lever:<slug> or pasted URLs (jobs.lever.co/<company>). This Actor accepts only Lever boards; other platforms are returned as one error row each.",
      "editor": "stringList",
      "prefill": [
        "lever:spotify",
        "https://jobs.lever.co/palantir",
        "lever:veeva"
      ],
      "default": [
        "lever:spotify",
        "https://jobs.lever.co/palantir",
        "lever:veeva"
      ]
    },
    "maxJobsPerBoard": {
      "title": "Max jobs per board",
      "type": "integer",
      "description": "0 = all",
      "default": 0,
      "minimum": 0
    }
  },
  "required": [
    "boards"
  ]
}