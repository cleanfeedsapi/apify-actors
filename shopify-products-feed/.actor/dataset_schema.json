{
  "actorSpecification": 1,
  "fields": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "shop": { "type": ["string", "null"] },
      "product_id": { "type": ["string", "null"] },
      "handle": { "type": ["string", "null"] },
      "title": { "type": ["string", "null"] },
      "vendor": { "type": ["string", "null"] },
      "product_type": { "type": ["string", "null"] },
      "tags": { "type": "array", "items": { "type": "string" } },
      "url": { "type": ["string", "null"] },
      "created_at": { "type": ["string", "null"] },
      "updated_at": { "type": ["string", "null"] },
      "published_at": { "type": ["string", "null"] },
      "variants_count": { "type": "integer" },
      "min_price": { "type": ["number", "null"] },
      "max_price": { "type": ["number", "null"] },
      "currency": { "type": ["string", "null"], "description": "Usually null; storefront products.json omits currency" },
      "available": { "type": "boolean" },
      "image": { "type": ["string", "null"] },
      "first_variant_sku": { "type": ["string", "null"] },
      "error": { "type": "string", "description": "Present only on a failed-shop row" }
    },
    "required": ["shop"]
  },
  "views": {
    "overview": {
      "title": "Products",
      "transformation": {
        "fields": [
          "shop",
          "title",
          "min_price",
          "max_price",
          "available",
          "updated_at",
          "url"
        ]
      },
      "display": {
        "component": "table",
        "properties": {
          "url": { "label": "Product", "format": "link" },
          "updated_at": { "label": "Updated", "format": "date" },
          "available": { "label": "In stock" }
        }
      }
    }
  }
}
