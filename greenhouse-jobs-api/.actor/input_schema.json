{
  "title": "ATS Jobs Feed input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "boards": {
      "title": "Boards",
      "type": "array",
      "description": "Greenhouse boards as greenhouse:<slug> or pasted URLs (boards.greenhouse.io/<board>). You can mix in other ATS boards too: greenhouse:, lever:, ashby:, workday:, smartrecruiters:, recruitee:.",
      "editor": "stringList",
      "prefill": [
        "greenhouse:stripe",
        "https://boards.greenhouse.io/airbnb",
        "greenhouse:discord"
      ],
      "default": [
        "greenhouse:stripe",
        "https://boards.greenhouse.io/airbnb",
        "greenhouse:discord"
      ]
    },
    "maxJobsPerBoard": {
      "title": "Max jobs per board",
      "type": "integer",
      "description": "0 = all",
      "default": 0,
      "minimum": 0
    }
  },
  "required": [
    "boards"
  ]
}